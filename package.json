{
  "name": "azubiquest",
  "version": "1.0.0",
  "private": true,
  "description": "AzubiQuest – Lernspiele für Berufsschüler. Jede Prüfung ist ein eigenes Spiel.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate-content && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate-content": "tsx scripts/validate-content.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.72.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^2.1.9"
  }
}
