{
  "name": "flare-dating",
  "productName": "Flare",
  "version": "0.1.0",
  "private": true,
  "description": "Flare – Dating-App für Web, Desktop (Windows/macOS), iOS und Android aus einer Codebasis",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:android": "npm run cap:sync && cap open android"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "app.flare.dating",
    "productName": "Flare",
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "directories": { "buildResources": "build" },
    "mac": { "category": "public.app-category.social-networking", "target": ["dmg"] },
    "win": { "target": ["nsis"] }
  }
}
